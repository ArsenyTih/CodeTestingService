@model CodeTestingService.Models.ViewModels.TeacherPageViewModel

<section class="page-header">
    <div>
        <p class="eyebrow">Роль: @Model.CurrentUserRole</p>
        <h1>@Model.CurrentUserName</h1>
        <p>Лабораторная работа №@Model.LabNumber</p>
    </div>
    <div class="button-row">
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="@Model.CurrentUserRole" asp-route-token="@Model.Token" asp-route-labNumber="1">ЛР 1</a>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="@Model.CurrentUserRole" asp-route-token="@Model.Token" asp-route-labNumber="2">ЛР 2</a>
    </div>
</section>

<section class="panel-grid">
    <article class="panel">
        <h2>Тестовый репозиторий</h2>
        @if (string.IsNullOrWhiteSpace(Model.TestRepositoryUrl))
        {
            <p class="empty-state">Ссылка на тестовый репозиторий не найдена.</p>
        }
        else
        {
            <p><a href="@Model.TestRepositoryUrl" target="_blank" rel="noreferrer">@Model.TestRepositoryUrl</a></p>
        }
    </article>

    <article class="panel panel-wide">
        <h2>Студенты и результаты</h2>
        @if (Model.Students.Count == 0)
        {
            <p class="empty-state">Для этого пользователя не найден список студентов.</p>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Студент</th>
                        <th>Репозиторий</th>
                        <th>Статус</th>
                        <th>Последняя проверка</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>
                                <strong>@student.StudentName</strong><br />
                                <span class="muted">ID: @student.StudentId</span>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(student.RepoUrl))
                                {
                                    <span class="empty-state">Не задан</span>
                                }
                                else
                                {
                                    <a href="@student.RepoUrl" target="_blank" rel="noreferrer">Открыть</a>
                                }
                            </td>
                            <td>@(student.Status ?? "Нет данных")</td>
                            <td>@(student.CheckedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Нет данных")</td>
                            <td>
                                <a class="btn btn-sm btn-primary"
                                   asp-controller="Results"
                                   asp-action="StudentDetails"
                                   asp-route-studentId="@student.StudentId"
                                   asp-route-labNumber="@Model.LabNumber"
                                   asp-route-token="@Model.Token">
                                    История
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </article>
</section>
